# ---------------------------------------------------------------------------
# Titan Mail SMTP (domain hosted via GoDaddy: zelectronics.co)
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Titan SMTP server. Use port 465 with SMTP_SECURE=true (implicit TLS),
# or port 587 with SMTP_SECURE=false (STARTTLS) if 465 is blocked.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true

# --- ALTERNATIVE: Gmail SMTP ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Full mailbox address + its password (or app password, if you enable one).
# For Gmail, you MUST use a 16-character App Password instead of your real password.
SMTP_USER=zaid@zelectronics.co
SMTP_PASS=your-mailbox-password

# What recipients see in the From: header.
FROM_NAME=Zaid
FROM_EMAIL=zaid@zelectronics.co

# Optional: replies go here instead of FROM_EMAIL.
REPLY_TO=

# ---------------------------------------------------------------------------
# Signature block (who signs the email body, as opposed to the From: header)
# ---------------------------------------------------------------------------
SIGNOFF_NAME=Zaid
# Full name for the "Best regards," sign-off line. Falls back to SIGNOFF_NAME
# if not set.
SIGNOFF_FULL_NAME=Zaid Shaikh
SIGNOFF_TITLE=Founder
SIGNOFF_PHONE=+91 84518 64754
WEBSITE_URL=www.zelectronics.co

# ---------------------------------------------------------------------------
# Company profile attachment
# ---------------------------------------------------------------------------

# Attach assets/Zelectronics-Company-Introduction.pdf to every mail.
# Set to false to send a link instead, or to send nothing while the sending
# domain is still new (unsolicited attachments are a heavier spam signal
# than a link, especially before SPF/DKIM/DMARC reputation is established).
ATTACH_COMPANY_PROFILE=true

# Override if the PDF lives somewhere else.
COMPANY_PROFILE_PATH=assets/Zelectronics-Company-Introduction.pdf

# ---------------------------------------------------------------------------
# Sending guardrails (used by the batch layer in later chunks)
# ---------------------------------------------------------------------------

# Hard ceiling on messages sent per calendar day (UTC-independent, local day).
DAILY_SEND_LIMIT=20

# Ceiling per rolling hour.
HOURLY_SEND_LIMIT=15

# Minimum pause between two sends, in milliseconds. Randomised +/- 30% at
# send time so the pattern does not look machine-perfect.
MIN_SEND_INTERVAL_MS=45000

# Set to true to log what WOULD be sent without actually talking to SMTP.
DRY_RUN=false

# ---------------------------------------------------------------------------
# Test script target (used by: npm run test:send)
# ---------------------------------------------------------------------------
TEST_RECIPIENT=your-personal-inbox@gmail.com

# ---------------------------------------------------------------------------
# Job application campaign (personal Gmail account)
#
# Completely separate from the Titan/Zelectronics settings above: its own
# mailbox, its own send log (data/job-application-send-log.json), its own
# rate limits. Sends the job-application template with your CV attached.
#
# Gmail requires an App Password (not your normal password):
#   Google Account -> Security -> 2-Step Verification -> App passwords
#   (2-Step Verification must be turned on first)
# ---------------------------------------------------------------------------
JOB_SMTP_HOST=smtp.gmail.com
JOB_SMTP_PORT=465
JOB_SMTP_SECURE=true

JOB_GMAIL_USER=mudassirshaikh6432@gmail.com
JOB_GMAIL_APP_PASSWORD=your-16-char-app-password

# What recipients see in the From: header.
JOB_FROM_NAME=Mudassir Shaikh
# Defaults to JOB_GMAIL_USER if unset.
JOB_FROM_EMAIL=
# Optional: replies go here instead of JOB_FROM_EMAIL.
JOB_REPLY_TO=

# Signature block for the application email body.
JOB_SENDER_FULL_NAME=Mudassir Shaikh
JOB_SENDER_PHONE=+91 8928519499
JOB_LINKEDIN_URL=https://www.linkedin.com/in/mudassir-shaikh-7b6325243/

# Path to the resume attached to every application mail.
JOB_CV_PATH=assets/Mudassir_CV.pdf

# Keep these low — a personal Gmail account has far less sending reputation
# than a business domain, and job-application mail is easy to flag as spam
# at volume.
JOB_DAILY_SEND_LIMIT=15
JOB_HOURLY_SEND_LIMIT=8
JOB_MIN_SEND_INTERVAL_MS=60000

# Test script target (used by: npm run job:test)
JOB_TEST_RECIPIENT=your-personal-inbox@gmail.com
